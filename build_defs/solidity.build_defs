"""Solidity build rules for Please.

This plugin provides rules for compiling Solidity smart contracts using Foundry's forge.
"""


def svm(
        name: str,
        version: str,
        os: str = None,
        arch: str = None,
        hashes: list = [],
        visibility: list = [],
):
    """Downloads pre-built svm binary for managing solc versions.

    svm (Solidity Version Manager) is a tool for installing and managing
    multiple versions of the Solidity compiler.

    Args:
        name: Name of the rule.
        version: svm-rs release version (e.g., "0.5.22").
        os: Target OS. Defaults to current OS.
        arch: Target architecture. Defaults to current arch.
        hashes: Optional SHA256 hashes to verify download.
        visibility: Visibility declaration.

    Example:
        svm(name = "svm", version = "0.5.22", visibility = ["PUBLIC"])
        # Access via: //third_party/solidity:svm
    """
    if not os:
        if CONFIG.OS == 'linux':
            os = 'linux'
        elif CONFIG.OS == 'darwin':
            os = 'darwin'
        else:
            fail(f'Unknown OS {CONFIG.OS}')

    if not arch:
        if CONFIG.ARCH == 'amd64':
            arch = 'amd64'
        elif CONFIG.ARCH == 'arm64':
            arch = 'arm64'
        else:
            fail(f'Unknown architecture {CONFIG.ARCH}')

    # Map to svm-rs platform naming (os_arch -> platform)
    platform_map = {
        'darwin_arm64': 'aarch64-apple-darwin',
        'darwin_amd64': 'x86_64-apple-darwin',
        'linux_arm64': 'aarch64-unknown-linux-gnu',
        'linux_amd64': 'x86_64-unknown-linux-gnu',
    }
    platform_key = f'{os}_{arch}'
    platform = platform_map.get(platform_key)
    if not platform:
        fail(f'Unsupported platform: {platform_key}')

    if not hashes:
        fail(f"svm({version}) requires hashes for the svm-rs-{platform}.tar.gz release asset")

    url = f"https://github.com/alloy-rs/svm-rs/releases/download/v{version}/svm-rs-{platform}.tar.gz"

    download = remote_file(
        name = f"_{name}#download",
        url = url,
        hashes = hashes,
    )

    return build_rule(
        name = name,
        srcs = [download],
        outs = ["svm"],
        cmd = f"tar -xzf $SRC && mv svm-rs-{platform}/svm $OUT",
        binary = True,
        visibility = visibility,
        building_description = f"Extracting svm v{version} for {platform}...",
    )


def foundry_release(
        name: str,
        version: str,
        hashes: dict,
        os: str = None,
        arch: str = None,
        visibility: list = [],
):
    """Downloads one Foundry release tarball and provides its forge binary.

    The asset is foundry_v<version>_<os>_<arch>.tar.gz. hashes maps
    linux_amd64, linux_arm64, darwin_amd64, and darwin_arm64 to the sha256
    of that platform's tarball. The build uses the host platform and fails
    when that platform has no hash.

    The forge output is selected with |forge, for example //third_party/solidity:foundry|forge.

    Args:
        name: Name of the rule.
        version: Foundry version, without a leading v (for example "1.5.0").
        hashes: Platform to sha256 hex, or sha256:<hex>.
        os: Target OS. Defaults to the host OS.
        arch: Target architecture. Defaults to the host arch.
        visibility: Visibility declaration.
    """
    if not os:
        if CONFIG.OS in ("linux", "darwin"):
            os = CONFIG.OS
        else:
            fail(f"Unknown OS {CONFIG.OS}")
    if not arch:
        if CONFIG.ARCH in ("amd64", "arm64"):
            arch = CONFIG.ARCH
        else:
            fail(f"Unknown architecture {CONFIG.ARCH}")

    platform = f"{os}_{arch}"
    digest = (hashes or {}).get(platform, "")
    if digest.startswith("sha256:"):
        digest = digest[len("sha256:"):]
    if not digest:
        fail(f"foundry_release({version}) has no sha256 for {platform}")

    url = f"https://github.com/foundry-rs/foundry/releases/download/v{version}/foundry_v{version}_{platform}.tar.gz"
    download = remote_file(
        name = f"_{name}#download",
        url = url,
        hashes = ["sha256:" + digest],
    )
    return build_rule(
        name = name,
        srcs = [download],
        outs = {"forge": [f"{platform}/forge"]},
        cmd = " && ".join([
            f"mkdir -p {platform}",
            "tar -xzf $SRC",
            f"mv forge {platform}/",
        ]),
        binary = True,
        visibility = visibility,
        building_description = f"Extracting Foundry v{version} for {platform}...",
    )


# solc static binaries.
# linux_amd64 and darwin_amd64 come from
# https://binaries.soliditylang.org/<platform>/list.json. The URL contains
# the compiler commit. Official builds do not publish darwin_arm64 for these
# versions, or linux_arm64 before 0.8.31. Those four binaries are the ones
# svm installs: alloy-rs/solc-builds e4b80d33 for darwin_arm64, and
# nikitastupin/solc 2287d432 for linux_arm64. sha256 is the file itself.
_SOLC_BUILDS = {
    "0.8.20": {
        "linux_amd64": {
            "url": "https://binaries.soliditylang.org/linux-amd64/solc-linux-amd64-v0.8.20+commit.a1b79de6",
            "sha256": "0479d44fdf9c501c25337fdc540419f1593b884a87b47f023da4f1c700fda782",
        },
        "linux_arm64": {
            "url": "https://raw.githubusercontent.com/nikitastupin/solc/2287d4326237172acf91ce42fd7ec18a67b7f512/linux/aarch64/solc-v0.8.20",
            "sha256": "d742f637a5846dc434903f1c2e19a510762d722b97a3b105f773df6aebdab39a",
        },
        "darwin_amd64": {
            "url": "https://binaries.soliditylang.org/macosx-amd64/solc-macosx-amd64-v0.8.20+commit.a1b79de6",
            "sha256": "fc329945e0068e4e955d0a7b583776dc8d25e72ab657a044618a7ce7dd0519aa",
        },
        "darwin_arm64": {
            "url": "https://raw.githubusercontent.com/alloy-rs/solc-builds/e4b80d33bc4d015b2fc3583e217fbf248b2014e1/macosx/aarch64/solc-v0.8.20",
            "sha256": "5d98c9ed892b74ecadc4ab7f93de6211fdde0351ef66f2cb90eb11630e30e2ab",
        },
    },
    "0.8.23": {
        "linux_amd64": {
            "url": "https://binaries.soliditylang.org/linux-amd64/solc-linux-amd64-v0.8.23+commit.f704f362",
            "sha256": "28726a452290c70e1984f15c53ad3088e7d98783ee3070b11b3664da77415732",
        },
        "linux_arm64": {
            "url": "https://raw.githubusercontent.com/nikitastupin/solc/2287d4326237172acf91ce42fd7ec18a67b7f512/linux/aarch64/solc-v0.8.23",
            "sha256": "16d29f5a113931bfd3af41e45b00b09aac7d9cc2a2ba8d947af2758516711a49",
        },
        "darwin_amd64": {
            "url": "https://binaries.soliditylang.org/macosx-amd64/solc-macosx-amd64-v0.8.23+commit.f704f362",
            "sha256": "e09a42980e44644be33a8455c87d095a4f0028e41a7dde1137f5d9a7605a2d62",
        },
        "darwin_arm64": {
            "url": "https://raw.githubusercontent.com/alloy-rs/solc-builds/e4b80d33bc4d015b2fc3583e217fbf248b2014e1/macosx/aarch64/solc-v0.8.23",
            "sha256": "df90fd580c92970e6441fa4b69b58e364e33f1ef0da6b8dae49af289e972a075",
        },
    },
}


def solc(
        name: str,
        version: str,
        visibility: list = [],
):
    """Installs one pinned solc static binary for the host platform.

    Versions in _SOLC_BUILDS are downloaded as remote files and checked
    against that table. A version or platform with no hash fails the build.
    The copy into the output is sandboxed; the download is a remote_file.

    Args:
        name: Name of the rule.
        version: Solidity version (for example "0.8.20").
        visibility: Visibility declaration.
    """
    builds = _SOLC_BUILDS.get(version)
    if not builds:
        pinned = ", ".join(sorted(_SOLC_BUILDS))
        fail(f"solc {version} is not pinned. Pinned versions: {pinned}")
    platform = CONFIG.OS + "_" + CONFIG.ARCH
    info = builds.get(platform)
    if not info:
        fail(f"solc {version} has no binary for {platform}")

    download = remote_file(
        name = f"_{name}#download",
        url = info["url"],
        hashes = ["sha256:" + info["sha256"]],
    )
    return genrule(
        name = name,
        srcs = [download],
        outs = [name],
        cmd = "cp $SRCS $OUT && chmod +x $OUT",
        binary = True,
        sandbox = True,
        visibility = visibility,
        building_description = f"Installing solc {version} for {platform}...",
    )


def solc_versions(
        versions: list,
        visibility: list = ["PUBLIC"],
):
    """Creates shared solc rules for multiple versions.

    This is a convenience function to pre-download and cache multiple solc versions.
    Use this in your third_party/solidity BUILD file to avoid repeated downloads.

    Args:
        versions: List of Solidity versions to download (e.g., ["0.8.20", "0.8.21"]).
        visibility: Visibility for all created rules.

    Example:
        # third_party/solidity/BUILD
        subinclude("//build_defs:solidity")

        solc_versions(
            versions = ["0.8.20", "0.8.21", "0.8.23"],
        )

        # Creates targets:
        # //third_party/solidity:solc_0_8_20
        # //third_party/solidity:solc_0_8_21
        # //third_party/solidity:solc_0_8_23

        # Then in .plzconfig:
        # [Plugin "solidity"]
        # SolcTool = //third_party/solidity:solc_0_8_20

    Returns:
        List of created rule names.
    """
    rules = []
    for version in versions:
        # Convert version to valid rule name (e.g., "0.8.20" -> "solc_0_8_20")
        name = "solc_" + version.replace(".", "_")
        solc(
            name = name,
            version = version,
            visibility = visibility,
        )
        rules.append(name)
    return rules


def solc_default(version: str):
    """Returns the target for a shared solc version.

    Use this to reference a pre-cached solc version in build rules.

    Args:
        version: Solidity version (e.g., "0.8.20").

    Returns:
        Target string (e.g., "//third_party/solidity:solc_0_8_20").

    Example:
        # In .plzconfig
        [Plugin "solidity"]
        SolcTool = %(call solc_default 0.8.20)
    """
    name = "solc_" + version.replace(".", "_")
    return f"//third_party/solidity:{name}"


def sol_library(
        name: str,
        src: str,
        deps: list = [],
        test_only: bool = False,
        plugins: dict = {},
        visibility: list = [],
):
    """Creates a Solidity library that can be used as a dependency.

    This rule creates a filegroup that provides sol_srcs for downstream rules.
    It's the basic building block for Solidity dependency management.

    Args:
        name: Name of the rule.
        src: Solidity source file.
        deps: Dependencies (other sol_library or sol_contract rules).
        test_only: If True, only available to test rules.
        plugins: Additional providers to add (e.g., sol_artifacts, go).
        visibility: Visibility specification.

    Returns:
        A filegroup rule that provides sol_srcs.
    """
    solidity_rule = filegroup(
        name = f'_{name}#solidity',
        srcs = [src],
        visibility = visibility,
        exported_deps = deps,
        requires = ['sol_srcs'],
        output_is_complete = False,
        test_only = test_only,
    )
    provides = {'sol_srcs': solidity_rule}

    for lang, rule in plugins.items():
        provides[lang] = rule

    return filegroup(
        name = name,
        srcs = [src],
        deps = provides.values(),
        provides = provides,
        visibility = visibility,
        output_is_complete = False,
        test_only = test_only,
    )


def sol_contract(
        name: str,
        src: str,
        deps: list = [],
        solc_version: str = None,
        solc_flags: str = '',
        evm_version: str = '',
        foundry_toml: str = '',
        optimizer = None,
        optimizer_runs = None,
        contract_names: list = [],
        skip: list = [],
        languages: list = None,
        test_only: bool = False,
        visibility: list = [],
        _is_dir: bool = False,
):
    """Compiles a Solidity contract using Forge.

    This is the main compilation rule. It uses Foundry's forge to compile
    Solidity contracts, extracts ABIs and bytecode, and optionally generates
    language bindings (currently Go via abigen).

    SolcPackage or SolcTool selects the solc binary passed to forge --use.
    With neither set, forge is given the version string and may download a
    compiler, which the sandbox does not allow.

    Args:
        name: Name of the rule.
        src: Solidity source file or directory.
        deps: Dependencies (other sol_library or sol_contract rules).
        solc_version: Solidity compiler version (e.g., "0.8.20"). Selects the
            SolcPackage target. Defaults to DefaultSolcVersion config.
        solc_flags: Additional flags for solc/forge.
        evm_version: EVM version passed to forge (e.g. "paris", "cancun").
            Empty uses foundry_toml when that is set, otherwise the compiler default.
        foundry_toml: Optional foundry.toml. evm_version, optimizer, and
            optimizer_runs are read from it when the matching argument is empty.
        optimizer: True or False. Empty uses foundry_toml, then the plugin default.
        optimizer_runs: Optimizer runs. Empty uses foundry_toml, then the plugin default.
        contract_names: Names of contracts in the source file. Required for
            multi-contract files when generating language bindings.
        skip: Contract names to skip during compilation.
        languages: Output languages (e.g., ['go'] for Go bindings). Defaults to
            the plugin's default_languages config.
        test_only: If True, only available to test rules.
        visibility: Visibility specification.

    Returns:
        sol_library rule that provides:
        - sol_srcs: Solidity source files
        - sol_artifacts: Compiled ABI and bytecode
        - go: Go bindings (if 'go' in languages and abigen_tool configured)
    """
    # Apply defaults from config
    if solc_version is None:
        solc_version = CONFIG.SOLIDITY.DEFAULT_SOLC_VERSION
    if languages is None:
        # Default to no language bindings when contract_names isn't specified.
        # This prevents "found packages X and Y" Go errors when a source file has
        # multiple contracts/interfaces that would each get their own package.
        # Users must explicitly request languages=['go'] AND provide contract_names.
        if contract_names:
            languages = CONFIG.SOLIDITY.DEFAULT_LANGUAGES or ['go']
        else:
            languages = []

    # Names come from please_sol's lexer. A comment or string that says
    # "contract" is not a declaration, and libraries are included.
    interfaces_rule = genrule(
        name = f"{name}_interfaces",
        srcs = [src],
        tools = {"plzsol": CONFIG.SOLIDITY.PLEASE_SOL_TOOL},
        out = f"{name}.interfaces",
        cmd = "$TOOLS_PLZSOL extract-decls $SRCS > $OUT",
        test_only = test_only,
    )

    # Build skip flags for contracts to exclude (SECURITY: quote each item)
    skip_cmd = ""
    for skipped in skip:
        quoted_skip = _shell_quote(skipped)
        skip_cmd += f" --skip {quoted_skip} "

    # solc_flags is one shell word. An empty string must not become an argument.
    quoted_solc_flags = _shell_quote(solc_flags) if solc_flags else ""

    # Copy main source and any dep .sol files from the same package to src/
    # This enables relative imports like "./Counter.sol" to work.
    # With a foundry.toml input the source is $SRCS_SRC, not $SRCS.
    pkg = package_name()
    src_var = "$SRCS_SRC" if foundry_toml else "$SRCS"
    setup_cmd = f'mkdir -p src && ([ -d "{src_var}" ] && cp -r "{src_var}"/* src/ 2>/dev/null || cp "{src_var}" src/ 2>/dev/null) && (find {pkg} -maxdepth 1 -name "*.sol" -exec cp {{}} src/ \\; 2>/dev/null || true)'
    solc_use_arg = _get_solc_use_arg(solc_version)
    resolve_cmd = _resolve_flags_cmd(
        evm_version,
        optimizer,
        optimizer_runs,
        '"$SRCS_FOUNDRY_TOML"' if foundry_toml else "",
    )
    collect_remappings = _remapping_args_cmd()

    # forge-wrap's exit code is forge's. A failed compile stops before
    # extract-artifacts, including when forge has already created out/.
    # Please puts the input at its repo path. That path is often under test/,
    # which forge compiles as well as src/, so the same contract appears twice.
    forge_lines = [
        "set -e",
        collect_remappings,
        setup_cmd,
        "printf '%s\\n' '[profile.default]' 'src = \"src\"' 'out = \"out\"' 'test = \"no-tests\"' 'script = \"no-scripts\"' > foundry.toml",
        "FLAGS=$(" + resolve_cmd + ")",
        "set +e",
        "$TOOLS_PLZSOL forge-wrap --forge \"$TOOLS_FORGE\" --remapping-file remappings.txt -- build --use "
        + solc_use_arg + " " + skip_cmd + " $FLAGS " + quoted_solc_flags
        + " --extra-output bin --extra-output-files bin --root . $REMAP_ARGS",
        "code=$?",
        "set -e",
        'if [ "$code" -ne 0 ]; then exit "$code"; fi',
        'mkdir -p "$OUT"',
        '$TOOLS_PLZSOL extract-artifacts --out out --dest "$OUT"',
    ]

    build_tools = _get_forge_tools(solc_version)
    build_tools["plzsol"] = CONFIG.SOLIDITY.PLEASE_SOL_TOOL
    forge_srcs = {"src": [src], "foundry_toml": [foundry_toml]} if foundry_toml else [src]

    forge_build = genrule(
        name = f"_{name}#forge_build",
        srcs = forge_srcs,
        deps = deps,
        requires = ['sol_srcs', 'sol_remappings'],
        tools = build_tools,
        out = f"{name}_out",
        needs_transitive_deps = True,
        output_is_complete = True,
        sandbox = CONFIG.SOLIDITY.SANDBOX,
        cmd = "\n".join(forge_lines),
        test_only = test_only,
    )
    plugins = {'sol_artifacts': forge_build}

    # Generate Go bindings if requested and abigen is configured
    abigen_tool = CONFIG.SOLIDITY.ABIGEN_TOOL
    go_ethereum_dep = _for_target_platform(CONFIG.SOLIDITY.GO_ETHEREUM_DEP) if CONFIG.SOLIDITY.GO_ETHEREUM_DEP else None

    if 'go' in languages and abigen_tool:
        go_srcs = genrule(
            name = f"_{name}#gosrcs",
            srcs = {
                "forge_build": forge_build,
                "interfaces": interfaces_rule,
            },
            tools = [abigen_tool],
            output_dirs = ["out/**"],
            cmd = "\n".join([
                "set -e",
                "mkdir out",
                "while IFS=$(printf '\\t') read -r kind name; do",
                '  if [ -z "$name" ]; then continue; fi',
                '  p_lower=$(printf "%s" "$name" | tr A-Z a-z)',
                '  abi="$SRCS_FORGE_BUILD/$name.abi"',
                '  bin="$SRCS_FORGE_BUILD/$name.bin"',
                '  if [ ! -f "$abi" ] || [ ! -f "$bin" ]; then echo "no artifact for $kind $name" >&2; exit 1; fi',
                '  $TOOL --type=instance --abi="$abi" --bin="$bin" --pkg="$p_lower" --out="out/$p_lower.go"',
                'done < "$SRCS_INTERFACES"',
            ]),
            needs_transitive_deps = True,
            visibility = visibility,
            test_only = test_only,
        )

        # Build Go libraries for each contract
        exported_deps = []
        go_deps = [go_ethereum_dep] if go_ethereum_dep else []

        if len(contract_names) == 0:
            import_path = package_name() + "/" + name.replace("_", "")
            go = go_library(
                name = f'_{name}#golib',
                srcs = [go_srcs],
                deps = go_deps,
                test_only = test_only,
                import_path = import_path,
                visibility = visibility,
            )
            exported_deps.append(go)

        pkg = package_name()
        for contract_name in contract_names:
            contract_name_lower = contract_name.lower()
            # SECURITY: Quote contract_name in shell command
            quoted_contract = _shell_quote(contract_name_lower)
            quoted_pkg = _shell_quote(pkg)
            contract_go_srcs = genrule(
                name = f"_{name}_{contract_name_lower}#gosrcs",
                srcs = [go_srcs],
                out = f'{contract_name_lower}.go',
                cmd = f'mv $PKG_DIR/{quoted_contract}.go . && echo {quoted_pkg}',
            )
            import_path = package_name() + "/" + contract_name_lower
            go = go_library(
                name = f"_{name}_{contract_name_lower}#golib",
                srcs = [contract_go_srcs],
                deps = go_deps,
                test_only = test_only,
                import_path = import_path,
                visibility = visibility,
            )
            exported_deps.append(go)

        golibs = filegroup(
            name = f"_{name}#golibs",
            exported_deps = exported_deps,
        )
        plugins['go'] = golibs

    # Return sol_library with all plugins
    return sol_library(
        name = name,
        src = src,
        deps = deps,
        test_only = test_only,
        plugins = plugins,
        visibility = visibility,
    )


def sol_get(
        name: str,
        repo: str,
        revision: str,
        hashes: list = [],
        deps: list = [],
        import_prefix: str = "",
        solc_version: str = None,
        package: str = '.',
        install: list = ['.'],
        strip: list = [],
        solc_flags: str = '',
        evm_version: str = '',
        foundry_toml: str = '',
        optimizer = None,
        optimizer_runs = None,
        contract_names: list = [],
        skip: list = [],
        languages: list = None,
        test_only: bool = False,
        visibility: list = [],
):
    """Downloads a Solidity library from GitHub and compiles it.

    This rule downloads Solidity source code from a GitHub repository
    and compiles it using sol_contract. Import remappings are automatically
    generated based on the import_prefix.

    Args:
        name: Name of the rule.
        repo: GitHub repo in 'org/repo' format (e.g., 'OpenZeppelin/openzeppelin-contracts').
        revision: Git revision (commit SHA, tag, or branch).
        hashes: SHA256 hashes for download verification. Format: ["sha256:abc123..."]
            Strongly recommended - verifies the download hasn't been tampered with.
        deps: Dependencies (other sol_library or sol_contract rules).
        import_prefix: Import path prefix for this library. Defaults to "{name}/".
            Example: "@openzeppelin/contracts/" allows imports like
            `import "@openzeppelin/contracts/token/ERC20/ERC20.sol";`
        solc_version: Solidity compiler version. Defaults to plugin config.
        package: Subdirectory within the repo containing sources.
        install: List of subdirectories to install from the package.
        strip: List of directory names to remove after extraction.
            Useful for removing test directories that contain incompatible Solidity versions.
            Example: strip = ["test", "sample-projects"]
        solc_flags: Additional solc flags.
        contract_names: Contract names for language binding generation.
        skip: Contracts to skip during compilation.
        languages: Output languages. Defaults to plugin config.
        test_only: If True, only available to test rules.
        visibility: Visibility specification.
    """
    # SECURITY: Validate no path traversal
    _validate_no_traversal(package, "package")
    for install_path in install:
        _validate_no_traversal(install_path, "install")
    for strip_dir in strip:
        _validate_no_traversal(strip_dir, "strip")

    org, _, repo_name = repo.partition('/')

    # GitHub archive bytes are not a stable checksum. Pin a commit and fail
    # closed when the zip no longer matches.
    if not hashes:
        fail(f"sol_get('{name}') requires hashes=['sha256:...'] for revision {revision}")

    zip_file = remote_file(
        name = f"_{name}#zip",
        url = f'https://github.com/{org}/{repo_name}/archive/{revision}.zip',
        hashes = hashes,
    )

    # SECURITY: Quote all path components
    # GitHub strips 'v' prefix from version tags in archive directory names
    # e.g., v1.9.4 becomes forge-std-1.9.4/ not forge-std-v1.9.4/
    archive_revision = revision.lstrip('v') if revision.startswith('v') else revision
    quoted_archive_revision = _shell_quote(archive_revision)
    quoted_repo_name = _shell_quote(repo_name)

    # GitHub archives use {repo_name}-{version} as the directory name
    archive_dir = f'{quoted_repo_name}-{quoted_archive_revision}'
    cmds = [f'$TOOL x $SRCS -o tmp && mkdir $OUTS']
    for install_path in install:
        quoted_install = _shell_quote(install_path)
        quoted_package = _shell_quote(package)

        if install_path == ".":
            # Copy entire package contents preserving structure
            cmds.append(f'cp -r tmp/{archive_dir}/{quoted_package}/* $OUTS/')
        else:
            # Copy specific subdirectory
            cmds.append(f'mkdir -p $OUTS/{quoted_install}')
            cmds.append(f'cp -r tmp/{archive_dir}/{quoted_package}/{quoted_install}/* $OUTS/{quoted_install}/')
        # Remove test files
        cmds.append(f'find $OUTS -name "*.t.sol" -delete 2>/dev/null || true')

    # Strip specified directories
    for strip_dir in strip:
        quoted_strip = _shell_quote(strip_dir)
        cmds.append(f'find $OUTS -type d -name {quoted_strip} -exec rm -rf {{}} + 2>/dev/null || true')

    extract_rule = build_rule(
        name = f"_{name}#extract",
        srcs = [zip_file],
        tools = [CONFIG.JARCAT_TOOL],
        cmd = "&&".join(cmds),
        outs = [name],
        visibility = visibility,
    )

    # Create remapping file: import_prefix=package/name/
    # This tells forge to resolve imports like "@openzeppelin/contracts/X" to "third_party/openzeppelin-contracts/X"
    # The package path prefix is needed because Please organizes dep files by package
    pkg = package_name()
    quoted_package = _shell_quote(package)
    quoted_name = _shell_quote(name)
    quoted_pkg = _shell_quote(pkg)

    if import_prefix:
        # Explicit import_prefix provided
        remapping_rule = genrule(
            name = f"_{name}#remapping",
            cmd = f'echo "{import_prefix}={pkg}/{name}/" > $OUT',
            outs = [f"{name}.remapping"],
            test_only = test_only,
        )
    else:
        # Auto-detect import_prefix from package.json using please_sol
        remapping_rule = genrule(
            name = f"_{name}#remapping",
            srcs = [zip_file],
            tools = {"plzsol": CONFIG.SOLIDITY.PLEASE_SOL_TOOL},
            cmd = f'$TOOLS_PLZSOL detect-prefix --zip=$SRCS --package={quoted_package} --name={quoted_name} --out_dir={quoted_pkg} > $OUT',
            outs = [f"{name}.remapping"],
            test_only = test_only,
        )

    # Create sol_library with remapping provider
    _sol_get_library(
        name = name,
        src = extract_rule,
        remapping = remapping_rule,
        deps = deps,
        solc_version = solc_version,
        solc_flags = solc_flags,
        evm_version = evm_version,
        foundry_toml = foundry_toml,
        optimizer = optimizer,
        optimizer_runs = optimizer_runs,
        contract_names = contract_names,
        skip = skip,
        languages = languages,
        test_only = test_only,
        visibility = visibility,
    )


def _sol_get_library(
        name: str,
        src,
        remapping,
        deps: list = [],
        solc_version: str = None,
        solc_flags: str = '',
        evm_version: str = '',
        foundry_toml: str = '',
        optimizer = None,
        optimizer_runs = None,
        contract_names: list = [],
        skip: list = [],
        languages: list = None,
        test_only: bool = False,
        visibility: list = [],
):
    """Internal helper for sol_get that creates the library with remapping support.

    If languages are specified, this will also compile the contracts and generate
    language bindings (e.g., Go bindings via abigen).
    """
    # Apply defaults from config
    if solc_version is None:
        solc_version = CONFIG.SOLIDITY.DEFAULT_SOLC_VERSION
    if languages is None:
        # Default to no language bindings when contract_names isn't specified.
        # This prevents "found packages X and Y" Go errors when a library has
        # multiple contracts/interfaces that would each get their own package.
        # Users must explicitly request languages=['go'] AND provide contract_names.
        if contract_names:
            languages = CONFIG.SOLIDITY.DEFAULT_LANGUAGES or ['go']
        else:
            languages = []

    # Create the solidity source filegroup
    solidity_rule = filegroup(
        name = f'_{name}#solidity',
        srcs = [src],
        visibility = visibility,
        exported_deps = deps,
        requires = ['sol_srcs'],
        output_is_complete = False,
        test_only = test_only,
    )

    # Create remapping filegroup that collects all remappings from deps
    remapping_fg = filegroup(
        name = f'_{name}#remappings',
        srcs = [remapping],
        visibility = visibility,
        exported_deps = deps,
        requires = ['sol_remappings'],
        output_is_complete = False,
        test_only = test_only,
    )

    provides = {
        'sol_srcs': solidity_rule,
        'sol_remappings': remapping_fg,
    }

    # Compile and generate bindings if requested
    if languages or contract_names:
        contract_deps = deps + [remapping_fg]
        contract = sol_contract(
            name = f'_{name}#contract',
            src = src,
            deps = contract_deps,
            solc_version = solc_version,
            solc_flags = solc_flags,
            evm_version = evm_version,
            foundry_toml = foundry_toml,
            optimizer = optimizer,
            optimizer_runs = optimizer_runs,
            contract_names = contract_names,
            skip = skip,
            languages = languages,
            test_only = test_only,
            visibility = visibility,
            _is_dir = True,
        )
        for lang in languages:
            provides[lang] = f':_{name}#contract'

    all_deps = [solidity_rule, remapping_fg]
    if languages or contract_names:
        all_deps.append(f':_{name}#contract')

    return filegroup(
        name = name,
        srcs = [src],
        deps = all_deps,
        provides = provides,
        visibility = visibility,
        output_is_complete = False,
        test_only = test_only,
    )


def sol_test(
        name: str,
        src: str,
        deps: list = [],
        solc_version: str = None,
        solc_flags: str = '',
        evm_version: str = '',
        foundry_toml: str = '',
        optimizer = None,
        optimizer_runs = None,
        visibility: list = [],
        timeout: int = 0,
        labels: list = [],
):
    """Runs Solidity tests using Forge.

    forge test compiles the sources once. Results are forge's JSON, rewritten
    to Go test lines so Please reports each test with its duration and, on
    failure, the revert reason.

    Args:
        name: Name of the rule.
        src: Test source file (typically *.t.sol).
        deps: Dependencies (other sol_library or sol_contract rules).
        solc_version: Solidity compiler version. Defaults to plugin config.
        solc_flags: Additional solc flags.
        evm_version: EVM version passed to forge. Empty uses foundry_toml,
            otherwise the compiler default.
        foundry_toml: Optional foundry.toml for evm_version and optimizer.
        optimizer: True or False. Empty uses foundry_toml, then the plugin default.
        optimizer_runs: Optimizer runs. Empty uses foundry_toml, then the plugin default.
        visibility: Visibility specification.
        timeout: Test timeout in seconds.
        labels: Additional labels for the test.
    """
    if solc_version is None:
        solc_version = CONFIG.SOLIDITY.DEFAULT_SOLC_VERSION

    # The test file is a source. Deps contribute their sol_srcs. There is no
    # separate sol_contract compile: forge test is the compile.
    sol_src_data = genrule(
        name = f'_{name}#solsrcs',
        srcs = [src],
        deps = deps,
        needs_transitive_deps = True,
        output_is_complete = True,
        requires = ['sol_srcs'],
        out = f"{name}_solsrcdata",
        cmd = "mkdir -p $OUT && mv * $OUT 2>/dev/null || true",
        visibility = visibility,
    )

    sol_remapping_data = genrule(
        name = f'_{name}#remappings',
        srcs = [src],
        deps = deps,
        needs_transitive_deps = True,
        requires = ['sol_remappings'],
        out = f"{name}_remappings",
        cmd = 'mkdir -p $OUT && find . -name "*.remapping" -exec cp {} $OUT/ \\; 2>/dev/null || true',
        visibility = visibility,
    )

    solc_use_arg = _get_solc_use_arg(solc_version)
    quoted_solc_flags = _shell_quote(solc_flags) if solc_flags else ""
    # The two-line foundry.toml written below is only src/test discovery.
    # A caller's foundry.toml contributes evm_version and optimizer as flags.
    toml_shell = ""
    if foundry_toml:
        toml_shell = '"$(location ' + foundry_toml + ')"'
    resolve_cmd = _resolve_flags_cmd(evm_version, optimizer, optimizer_runs, toml_shell)

    test_tools = _get_forge_tools(solc_version)
    test_tools["plzsol"] = CONFIG.SOLIDITY.PLEASE_SOL_TOOL

    test_lines = [
        "set -e",
        _remapping_args_cmd(f"$(location {sol_remapping_data})"),
        f"mv $(location {sol_src_data}) srcstage",
        # Deps arrive under their package directories. Drop a same-named
        # top-level directory before flattening, or mv refuses to overwrite it.
        'for d in srcstage/*/; do rm -rf "$(basename "$d")" 2>/dev/null || true; done',
        "mv srcstage/* . && rm -rf srcstage",
        "printf '[profile.default]\\nsrc = \".\"\\ntest = \".\"\\n' > foundry.toml",
        "FLAGS=$(" + resolve_cmd + ")",
        "set +e",
        "$TOOLS_PLZSOL forge-wrap --forge \"$TOOLS_FORGE\" --remapping-file remappings.txt -- test --root . --use "
        + solc_use_arg + " --json $FLAGS " + quoted_solc_flags + " $REMAP_ARGS $TEST_ARGS > forge.json",
        "code=$?",
        "set -e",
        '$TOOLS_PLZSOL forge-results --json forge.json --out test.results',
        'exit "$code"',
    ]

    data = [sol_src_data, sol_remapping_data]
    if foundry_toml:
        data.append(foundry_toml)

    return gentest(
        name = name,
        data = data,
        sandbox = CONFIG.SOLIDITY.SANDBOX,
        test_tools = test_tools,
        test_cmd = "\n".join(test_lines),
        timeout = timeout,
        labels = labels,
        visibility = visibility,
    )


def _shell_quote(s: str) -> str:
    if not s:
        return "''"
    return "'" + s.replace("'", "'\\''") + "'"


def _validate_no_traversal(path: str, param_name: str):
    if '..' in path:
        fail(f"{param_name} cannot contain '..': {path}")


def _opt_word(optimizer) -> str:
    if optimizer == None:
        return ""
    if optimizer:
        return "true"
    return "false"


def _runs_word(optimizer_runs) -> str:
    if optimizer_runs == None:
        return ""
    return str(optimizer_runs)


def _resolve_flags_cmd(evm_version: str, optimizer, optimizer_runs, toml_shell: str) -> str:
    """Shell that prints forge compiler flags.

    toml_shell is a shell word for the foundry.toml path, or "" when there
    isn't one. Explicit rule arguments win over the file. Keys the file does
    not set fall through to the plugin defaults.
    """
    default_opt = "true" if CONFIG.SOLIDITY.OPTIMIZE else "false"
    default_runs = str(CONFIG.SOLIDITY.OPTIMIZER_RUNS or 100)
    toml = ("--foundry-toml " + toml_shell + " ") if toml_shell else ""
    return (
        "$TOOLS_PLZSOL resolve-flags "
        + toml
        + "--evm-version " + _shell_quote(evm_version or "") + " "
        + "--optimize " + _shell_quote(_opt_word(optimizer)) + " "
        + "--optimizer-runs " + _shell_quote(_runs_word(optimizer_runs)) + " "
        + "--default-optimize=" + default_opt + " "
        + "--default-optimizer-runs " + default_runs
    )


def _remapping_args_cmd(search_path: str = ".") -> str:
    """Writes remappings.txt and sets $REMAP_ARGS for forge and forge-wrap."""
    return f''': > remappings.txt
for f in $(find {search_path} -name "*.remapping" 2>/dev/null); do
  cat "$f" >> remappings.txt
done
REMAP_ARGS=""
while IFS= read -r line; do
  if [ -n "$line" ]; then
    REMAP_ARGS="$REMAP_ARGS --remappings $line"
  fi
done < remappings.txt
'''


def _local_solc(solc_version: str) -> str:
    """Returns the solc target a rule compiles with, or "" for forge to download one.

    SolcPackage, when set, holds one target per version (as solc_versions()
    names them), and the rule's own solc_version picks among them: a version the
    package does not define fails the build rather than compiling with another.
    Otherwise SolcTool, one compiler for every rule.

    Args:
        solc_version: Solidity version (e.g., "0.8.20").
    """
    package = CONFIG.SOLIDITY.SOLC_PACKAGE
    if package:
        # plz canonicalises a label-like config value ("//third_party/solidity"
        # arrives as ".../third_party/solidity:solidity"), so drop the name.
        if ":" in package:
            package = ":".join(package.split(":")[:-1])
        return package + ":solc_" + solc_version.replace(".", "_")
    return CONFIG.SOLIDITY.SOLC_TOOL or ""


def _forge_tool() -> str:
    """The forge binary a rule runs.

    Empty fails with the foundry_release() shape. A host path is invisible
    inside the sandbox, so it is only accepted with Sandbox = false.
    """
    tool = CONFIG.SOLIDITY.FORGE_TOOL or ""
    if not tool:
        fail(
            "ForgeTool is not set. Pin a release with foundry_release() and point ForgeTool at its forge output, "
            "for example //third_party/solidity:foundry|forge. A host path such as ~/.foundry/bin/forge needs Sandbox = false."
        )
    # Please rewrites a // label from config to /////pkg:name. A build label
    # always has at least two leading slashes. One slash, or ~, is a host path.
    host = tool.startswith("~") or (tool.startswith("/") and not tool.startswith("//"))
    if CONFIG.SOLIDITY.SANDBOX and host:
        fail(
            f"ForgeTool is {tool}, a host path the sandbox cannot see. "
            "Set Sandbox = false for local development, or point ForgeTool at a foundry_release() target."
        )
    return tool


def _get_forge_tools(solc_version: str) -> dict:
    """Returns tools dict with forge and, when one is configured, solc.

    Args:
        solc_version: Solidity version the rule compiles with.

    Returns:
        Dict suitable for tools parameter of genrule/gentest.
    """
    tools = {"forge": _forge_tool()}
    local_solc = _local_solc(solc_version)
    if CONFIG.SOLIDITY.SANDBOX and not local_solc:
        fail(
            f"Sandbox is true and solc {solc_version} is not configured. "
            "Add solc_versions() and set SolcPackage, or set Sandbox = false so forge can fetch solc itself."
        )
    if local_solc:
        tools["solc"] = local_solc
    return tools


def _get_solc_use_arg(solc_version: str) -> str:
    """Returns the --use argument for forge.

    If a local solc is configured (SolcPackage or SolcTool), returns $TOOLS_SOLC.
    Otherwise returns the quoted version string, which forge downloads.

    Args:
        solc_version: Solidity version (e.g., "0.8.20").

    Returns:
        String suitable for --use flag.
    """
    if _local_solc(solc_version):
        return "$TOOLS_SOLC"
    return _shell_quote(solc_version)


def _for_target_platform(label:str):
    """A dependency's label from config, for the platform this package builds
    for. Please reads a config label as the host repo's (inside a subrepo it
    arrives as /////pkg:name), so inside an architecture subrepo such as
    ///linux_amd64 the bindings would link go-ethereum built for the host.
    go-rules rewrites its Stdlib the same way. Building for the host, the
    label is returned as it is."""
    if CONFIG.OS == CONFIG.HOSTOS and CONFIG.ARCH == CONFIG.HOSTARCH:
        return label
    if label.startswith("/////"):
        label = label.removeprefix("///")
    if not label.startswith("//") or label.startswith("///"):
        fail(f"GoEthereumDep {label} is not a //-rooted label; it cannot be placed in ///{CONFIG.OS}_{CONFIG.ARCH}")
    return f"///{CONFIG.OS}_{CONFIG.ARCH}{label}"
